<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CarSharing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_CarSharing" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Authorize" name="Авторизация клиента">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectCar" name="Выбор автомобиля и тарифа">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Docs" name="Документы подтверждены?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes1</bpmn:outgoing>
      <bpmn:outgoing>Flow_No1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Payment" name="Проверка оплаты">
      <bpmn:incoming>Flow_Yes1</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Средства достаточны?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Split">
      <bpmn:incoming>Flow_Yes2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Reserve" name="Резервирование автомобиля">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Prepare" name="Подготовка автомобиля">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Parallel_Join">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_StartRental" name="Начало аренды">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Завершение">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_No1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Authorize" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Authorize" targetRef="Task_SelectCar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectCar" targetRef="Gateway_Docs" />
    <bpmn:sequenceFlow id="Flow_Yes1" name="Да" sourceRef="Gateway_Docs" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_No1" name="Нет" sourceRef="Gateway_Docs" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Payment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_Yes2" name="Да" sourceRef="Gateway_Payment" targetRef="Gateway_Parallel_Split" />
    <bpmn:sequenceFlow id="Flow_Loop" name="Нет" sourceRef="Gateway_Payment" targetRef="Task_SelectCar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Parallel_Split" targetRef="Task_Reserve" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Parallel_Split" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Reserve" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Prepare" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Parallel_Join" targetRef="Task_StartRental" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_StartRental" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_CarSharing">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="110" y="272" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Authorize_di" bpmnElement="Task_Authorize">
        <dc:Bounds x="200" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectCar_di" bpmnElement="Task_SelectCar">
        <dc:Bounds x="350" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Docs_di" bpmnElement="Gateway_Docs" isMarkerVisible="true">
        <dc:Bounds x="500" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="175" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Payment_di" bpmnElement="Task_Payment">
        <dc:Bounds x="600" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Payment_di" bpmnElement="Gateway_Payment" isMarkerVisible="true">
        <dc:Bounds x="750" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730" y="175" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parallel_Split_di" bpmnElement="Gateway_Parallel_Split">
        <dc:Bounds x="900" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reserve_di" bpmnElement="Task_Reserve">
        <dc:Bounds x="1000" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prepare_di" bpmnElement="Task_Prepare">
        <dc:Bounds x="1000" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parallel_Join_di" bpmnElement="Gateway_Parallel_Join">
        <dc:Bounds x="1120" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartRental_di" bpmnElement="Task_StartRental">
        <dc:Bounds x="1220" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1380" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1385" y="272" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="150" y="240" />
        <di:waypoint x="200" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="300" y="240" />
        <di:waypoint x="350" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="450" y="240" />
        <di:waypoint x="500" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes1_di" bpmnElement="Flow_Yes1">
        <di:waypoint x="550" y="240" />
        <di:waypoint x="600" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="565" y="215" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No1_di" bpmnElement="Flow_No1">
        <di:waypoint x="525" y="265" />
        <di:waypoint x="525" y="480" />
        <di:waypoint x="1405" y="480" />
        <di:waypoint x="1405" y="265" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="300" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="700" y="240" />
        <di:waypoint x="750" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes2_di" bpmnElement="Flow_Yes2">
        <di:waypoint x="800" y="240" />
        <di:waypoint x="900" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="215" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Loop_di" bpmnElement="Flow_Loop">
        <di:waypoint x="775" y="215" />
        <di:waypoint x="775" y="150" />
        <di:waypoint x="400" y="150" />
        <di:waypoint x="400" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="580" y="130" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="925" y="215" />
        <di:waypoint x="925" y="140" />
        <di:waypoint x="1000" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="925" y="265" />
        <di:waypoint x="925" y="360" />
        <di:waypoint x="1000" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1100" y="140" />
        <di:waypoint x="1145" y="140" />
        <di:waypoint x="1145" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1100" y="360" />
        <di:waypoint x="1145" y="360" />
        <di:waypoint x="1145" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1170" y="240" />
        <di:waypoint x="1220" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1320" y="240" />
        <di:waypoint x="1380" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
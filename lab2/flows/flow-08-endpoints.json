        "func": "const id = msg.req.params.id;\nif (id === '1') {\n    msg.statusCode = 200;\n    msg.payload = { id: 1, name: 'Item One', author: 'Горбунов' };\n} else if (id === '2') {\n    msg.statusCode = 200;\n    msg.payload = { id: 2, name: 'Item Two', author: 'Горбунов' };\n} else {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Not found', id: id };\n}\nreturn msg;",
